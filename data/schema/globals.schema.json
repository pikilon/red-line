{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "globals.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "factions", "maps", "ai", "damageTypes", "armorClasses", "damageModifiers", "startingCredits",
    "lowPowerMinSpeedPercent", "lowPowerMaxSpeedPercent", "maxQueue", "dockRangeCenti", "commonTypes"
  ],
  "properties": {
    "factions": { "$ref": "#/$defs/idList" },
    "maps": { "$ref": "#/$defs/idList" },
    "ai": { "$ref": "#/$defs/idList" },
    "aiDifficulties": {
      "description": "Spec 05 §9: AI difficulty levels, easiest first.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "thinkTicks", "forcePercent", "triggerDelayPercent", "incomePercent"],
        "properties": {
          "id": { "$ref": "faction.schema.json#/$defs/id" },
          "thinkTicks": { "type": "integer", "minimum": 1, "maximum": 150 },
          "forcePercent": { "type": "integer", "minimum": 10, "maximum": 400 },
          "triggerDelayPercent": { "type": "integer", "minimum": 10, "maximum": 400 },
          "extraHarvesters": { "type": "integer", "minimum": 0, "maximum": 10 },
          "incomePercent": { "type": "integer", "minimum": 10, "maximum": 400 },
          "retreatHpPercent": { "type": "integer", "minimum": 0, "maximum": 90 },
          "buildableForcesOnly": { "type": "boolean" }
        }
      }
    },
    "saves": { "$ref": "#/$defs/idList" },
    "features": { "$ref": "#/$defs/idList" },
    "damageTypes": { "$ref": "#/$defs/keyList" },
    "armorClasses": { "$ref": "#/$defs/keyList" },
    "damageModifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "startingCredits": { "type": "integer", "minimum": 0 },
    "lowPowerMinSpeedPercent": { "$ref": "#/$defs/percent" },
    "lowPowerMaxSpeedPercent": { "$ref": "#/$defs/percent" },
    "maxQueue": { "type": "integer", "minimum": 1, "maximum": 9 },
    "dockRangeCenti": { "type": "integer", "minimum": 1 },
    "dockSlots": { "type": "integer", "minimum": 1, "maximum": 10 },
    "sellRefundPercent": { "$ref": "#/$defs/percent" },
    "aimToleranceDeg": { "$ref": "#/$defs/aimDeg" },
    "turretRecenterTicks": { "type": "integer", "minimum": 0 },
    "guard": {
      "description": "Spec 49 §3.2: guard radii as percent of sight around the post, and the chase time in ticks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["innerPercent", "outerPercent", "chaseTicks"],
      "properties": {
        "innerPercent": { "type": "integer", "minimum": 1 },
        "outerPercent": { "type": "integer", "minimum": 1 },
        "chaseTicks": { "type": "integer", "minimum": 0 }
      }
    },
    "veterancy": {
      "description": "Spec 50 §3.3: bonuses per rank (regular, veteran, elite, heroic) in percent, and the self-heal of the higher ranks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["healthPercent", "damagePercent", "rateOfFirePercent"],
      "properties": {
        "healthPercent": { "$ref": "#/$defs/rankPercents" },
        "damagePercent": { "$ref": "#/$defs/rankPercents" },
        "rateOfFirePercent": { "$ref": "#/$defs/rankPercents" },
        "selfHeal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromRank", "intervalTicks", "permille"],
          "properties": {
            "fromRank": { "type": "integer", "minimum": 1, "maximum": 3 },
            "intervalTicks": { "type": "integer", "minimum": 1 },
            "permille": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      }
    },
    "general": {
      "description": "Spec 63: player ranks (skill points that reach each, General's points each grants) and the General's powers catalogue.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ranks", "powers"],
      "properties": {
        "ranks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["xp", "points"],
            "properties": {
              "xp": { "type": "integer", "minimum": 0 },
              "points": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "powers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "rank", "cost", "rechargeTicks", "effect"],
            "properties": {
              "id": { "$ref": "faction.schema.json#/$defs/id" },
              "rank": { "type": "integer", "minimum": 1 },
              "cost": { "type": "integer", "minimum": 1 },
              "rechargeTicks": { "type": "integer", "minimum": 1 },
              "factions": { "type": "array", "items": { "$ref": "faction.schema.json#/$defs/id" } },
              "effect": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "radiusCenti"],
                    "properties": { "kind": { "const": "scan" }, "radiusCenti": { "type": "integer", "minimum": 100 } }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "radiusCenti", "percent"],
                    "properties": {
                      "kind": { "const": "repair" },
                      "radiusCenti": { "type": "integer", "minimum": 100 },
                      "percent": { "type": "integer", "minimum": 1, "maximum": 100 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "spreadCenti", "impacts", "damage", "splashCenti", "damageType"],
                    "properties": {
                      "kind": { "const": "barrage" },
                      "spreadCenti": { "type": "integer", "minimum": 0 },
                      "impacts": { "type": "integer", "minimum": 1, "maximum": 60 },
                      "damage": { "type": "integer", "minimum": 1 },
                      "splashCenti": { "type": "integer", "minimum": 1 },
                      "damageType": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "unit", "count"],
                    "properties": {
                      "kind": { "const": "paradrop" },
                      "unit": { "$ref": "faction.schema.json#/$defs/id" },
                      "count": { "type": "integer", "minimum": 1, "maximum": 8 }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "crushDodgeLookaheadCenti": { "type": "integer", "minimum": 0 },
    "crushDodgeMissOneIn": { "type": "integer", "minimum": 0 },
    "locomotors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/locomotor" } },
    "commonTypes": { "type": "array", "items": { "$ref": "faction.schema.json#/$defs/type" } },
    "lateTypes": {
      "description": "Spec 36: common types listed after the factions' types, so adding one keeps every earlier type index.",
      "type": "array",
      "items": { "$ref": "faction.schema.json#/$defs/type" }
    }
  },
  "$defs": {
    "rankPercents": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 1 } },
    "idList": { "type": "array", "minItems": 1, "items": { "$ref": "faction.schema.json#/$defs/id" } },
    "keyList": { "type": "array", "minItems": 1, "items": { "$ref": "faction.schema.json#/$defs/key" } },
    "percent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "aimDeg": { "type": "integer", "minimum": 1, "maximum": 45 },
    "locomotor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["foot", "tracks", "wheels", "air"] },
        "class": { "description": "Spec 43 §4.1: altitude band of an air locomotor.", "enum": ["low", "high"] },
        "minSpeedPercent": { "description": "Spec 43 §4.1: percent of the top speed a fixed-wing flyer never drops below while airborne.", "type": "integer", "minimum": 1, "maximum": 100 },
        "noseConeDeg": { "description": "Spec 43 §4.1: half-angle of the cone a fixed-wing flyer fires through.", "type": "integer", "minimum": 1, "maximum": 90 },
        "altitudeCenti": { "description": "Spec 43 §4.1: flight height, for rendering.", "type": "integer", "minimum": 0 },
        "pivotAngleDeg": { "type": "integer", "minimum": 1, "maximum": 180 },
        "minTurnSpeedPercent": { "type": "integer", "minimum": 25, "maximum": 100 },
        "slowTurnAngleDeg": { "type": "integer", "minimum": 1, "maximum": 90 },
        "accelCenti": { "type": "integer", "minimum": 1 },
        "brakingCenti": { "type": "integer", "minimum": 1 },
        "reverseAngleDeg": { "type": "integer", "minimum": 90, "maximum": 180 },
        "reverseMaxCenti": { "type": "integer", "minimum": 0 },
        "reverseSpeedPercent": { "type": "integer", "minimum": 10, "maximum": 100 },
        "crusherLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
        "shoveDamage": { "type": "integer", "minimum": 0 },
        "shovePushCenti": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
