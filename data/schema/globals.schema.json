{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "globals.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "factions", "maps", "ai", "damageTypes", "armorClasses", "damageModifiers", "startingCredits",
    "lowPowerMinSpeedPercent", "lowPowerMaxSpeedPercent", "maxQueue", "dockRangeCenti", "sellRefundPercent", "commonTypes"
  ],
  "properties": {
    "factions": { "$ref": "#/$defs/idList" },
    "maps": { "$ref": "#/$defs/idList" },
    "ai": { "$ref": "#/$defs/idList" },
    "saves": { "$ref": "#/$defs/idList" },
    "features": { "$ref": "#/$defs/idList" },
    "damageTypes": { "$ref": "#/$defs/keyList" },
    "armorClasses": { "$ref": "#/$defs/keyList" },
    "damageModifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "startingCredits": { "type": "integer", "minimum": 0 },
    "lowPowerMinSpeedPercent": { "$ref": "#/$defs/percent" },
    "lowPowerMaxSpeedPercent": { "$ref": "#/$defs/percent" },
    "maxQueue": { "type": "integer", "minimum": 1, "maximum": 9 },
    "dockRangeCenti": { "type": "integer", "minimum": 1 },
    "sellRefundPercent": { "$ref": "#/$defs/percent" },
    "aimToleranceDeg": { "$ref": "#/$defs/aimDeg" },
    "turretRecenterTicks": { "type": "integer", "minimum": 0 },
    "locomotors": { "type": "object", "additionalProperties": { "$ref": "#/$defs/locomotor" } },
    "commonTypes": { "type": "array", "items": { "$ref": "faction.schema.json#/$defs/type" } },
    "lateTypes": {
      "description": "Spec 36: common types listed after the factions' types, so adding one keeps every earlier type index.",
      "type": "array",
      "items": { "$ref": "faction.schema.json#/$defs/type" }
    }
  },
  "$defs": {
    "idList": { "type": "array", "minItems": 1, "items": { "$ref": "faction.schema.json#/$defs/id" } },
    "keyList": { "type": "array", "minItems": 1, "items": { "$ref": "faction.schema.json#/$defs/key" } },
    "percent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "aimDeg": { "type": "integer", "minimum": 1, "maximum": 45 },
    "locomotor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["foot", "tracks", "wheels"] },
        "pivotAngleDeg": { "type": "integer", "minimum": 1, "maximum": 180 },
        "minTurnSpeedPercent": { "type": "integer", "minimum": 25, "maximum": 100 },
        "slowTurnAngleDeg": { "type": "integer", "minimum": 1, "maximum": 90 },
        "accelCenti": { "type": "integer", "minimum": 1 },
        "brakingCenti": { "type": "integer", "minimum": 1 },
        "reverseAngleDeg": { "type": "integer", "minimum": 90, "maximum": 180 },
        "reverseMaxCenti": { "type": "integer", "minimum": 0 },
        "reverseSpeedPercent": { "type": "integer", "minimum": 10, "maximum": 100 },
        "crusherLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
        "shoveDamage": { "type": "integer", "minimum": 0 },
        "shovePushCenti": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
