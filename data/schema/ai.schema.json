{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "faction", "harvesters", "defenseRadiusCenti", "buildOrder", "taskForces", "triggers"],
  "properties": {
    "id": { "$ref": "faction.schema.json#/$defs/id" },
    "faction": { "$ref": "faction.schema.json#/$defs/id" },
    "harvesters": { "type": "integer", "minimum": 0, "maximum": 20 },
    "defenseRadiusCenti": { "type": "integer", "minimum": 0, "maximum": 12800 },
    "garrisonRadiusCenti": { "description": "Spec 31 block 2: enemy infantry this close to a garrisonable building make the AI garrison it with nearby idle infantry; 0 or absent turns the rule off.", "type": "integer", "minimum": 0, "maximum": 12800 },
    "buildOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "faction.schema.json#/$defs/id" }
    },
    "taskForces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskForce" }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trigger" }
    },
    "guards": {
      "description": "Spec 43 §5: units the AI keeps built at home and never launches (anti-air vehicles, jammers); wanted from minTick on, or at once while enemy flyers are over the base.",
      "type": "array",
      "items": { "$ref": "#/$defs/guard" }
    }
  },
  "$defs": {
    "taskForce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "units"],
      "properties": {
        "id": { "$ref": "faction.schema.json#/$defs/id" },
        "units": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 20 }
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "count", "minTick"],
      "properties": {
        "unit": { "$ref": "faction.schema.json#/$defs/id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 10 },
        "minTick": { "type": "integer", "minimum": 0 }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskForce", "weight", "minTick"],
      "properties": {
        "taskForce": { "$ref": "faction.schema.json#/$defs/id" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "minTick": { "type": "integer", "minimum": 0 },
        "once": { "description": "Spec 43 §5: an opening move, taken once per match before any weighted roll, as soon as minTick has passed (file order).", "type": "boolean" }
      }
    }
  }
}
