{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "save.schema.json",
  "description": "Setup-form example save (spec 19 §4.1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "map", "victory"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "map": { "$ref": "#/$defs/id" },
    "seed": { "type": "integer", "minimum": 0 },
    "victory": { "type": "boolean" },
    "debug": { "type": "boolean" },
    "starts": { "type": "boolean" },
    "speed": { "type": "integer", "minimum": 1, "maximum": 8 },
    "credits": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
    "ai": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player", "personality", "active"],
        "properties": {
          "player": { "$ref": "#/$defs/player" },
          "personality": { "$ref": "#/$defs/id" },
          "active": { "type": "boolean" }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "controlled": { "$ref": "#/$defs/player" },
        "revealed": { "type": "boolean" },
        "gore": { "type": "boolean" },
        "generatedTextures": { "type": "boolean" },
        "fpsPanel": { "type": "boolean" },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "zoom"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "features": {
      "description": "Spec 35: map features damaged at tick 0, by a cell they cover.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "hpPercent"],
        "properties": {
          "at": { "$ref": "#/$defs/pair" },
          "hpPercent": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    },
    "trenches": {
      "description": "Spec 35 5b: trenches already dug at tick 0 (2x1 earthwork rows).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at"],
        "properties": {
          "at": { "$ref": "#/$defs/pair" },
          "rot": { "type": "integer", "minimum": 0, "maximum": 3 },
          "hpPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
          "variant": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player", "type"],
        "properties": {
          "player": { "$ref": "#/$defs/player" },
          "type": { "$ref": "#/$defs/id" },
          "atCenti": { "$ref": "#/$defs/pair" },
          "origin": { "$ref": "#/$defs/pair" },
          "label": { "$ref": "#/$defs/id" },
          "hpPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
          "buildPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "order": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false,
            "properties": {
              "attack": { "$ref": "#/$defs/id" },
              "moveCenti": { "$ref": "#/$defs/pair" },
              "harvest": { "$ref": "#/$defs/id" },
              "attackGroundCenti": { "$ref": "#/$defs/pair" },
              "garrison": { "$ref": "#/$defs/pair" },
              "board": { "$ref": "#/$defs/id" },
              "repair": { "$ref": "#/$defs/pair" },
              "dig": { "$ref": "#/$defs/pair" },
              "rally": { "$ref": "#/$defs/pair" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "player": { "type": "integer", "minimum": 0, "maximum": 7 },
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
