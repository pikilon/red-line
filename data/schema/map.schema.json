{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "width", "height", "blocked", "depots", "starts"],
  "properties": {
    "id": { "$ref": "faction.schema.json#/$defs/id" },
    "width": { "type": "integer", "minimum": 16, "maximum": 256 },
    "height": { "type": "integer", "minimum": 16, "maximum": 256 },
    "blocked": { "type": "array", "items": { "$ref": "#/$defs/cells4" } },
    "depots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "amount"],
        "properties": {
          "origin": { "$ref": "#/$defs/pair" },
          "amount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["center", "radius", "height"],
            "properties": {
              "center": { "$ref": "#/$defs/pair" },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "$ref": "#/$defs/height" }
            }
          }
        },
        "ridges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "radius", "height"],
            "properties": {
              "from": { "$ref": "#/$defs/pair" },
              "to": { "$ref": "#/$defs/pair" },
              "radius": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "$ref": "#/$defs/height" }
            }
          }
        },
        "plateaus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rect", "height"],
            "properties": {
              "rect": { "$ref": "#/$defs/cells4" },
              "height": { "$ref": "#/$defs/height" },
              "slope": { "type": "number", "minimum": 0 },
              "rough": { "type": "number", "minimum": 0 }
            }
          }
        },
        "ramps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "width", "height"],
            "properties": {
              "from": { "$ref": "#/$defs/pair" },
              "to": { "$ref": "#/$defs/pair" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "height": { "$ref": "#/$defs/height" }
            }
          }
        }
      }
    },
    "starts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["faction", "hq", "dozerCenti"],
        "properties": {
          "faction": { "$ref": "faction.schema.json#/$defs/id" },
          "hq": { "$ref": "#/$defs/pair" },
          "dozerCenti": { "$ref": "#/$defs/pair" }
        }
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 }
    },
    "height": { "type": "integer", "minimum": 0, "maximum": 255 },
    "cells4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
