{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hq", "dozer", "weapons", "types"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "hq": { "$ref": "#/$defs/id" },
    "dozer": { "$ref": "#/$defs/id" },
    "weapons": { "type": "array", "items": { "$ref": "#/$defs/weapon" } },
    "lateWeapons": {
      "description": "Spec 43: weapons listed after every faction's weapons, so adding one keeps every earlier weapon index.",
      "type": "array",
      "items": { "$ref": "#/$defs/weapon" }
    },
    "lateTypes": {
      "description": "Spec 43: types listed after the common late types, so adding one keeps every earlier type index.",
      "type": "array",
      "items": { "$ref": "#/$defs/factionType" }
    },
    "types": { "type": "array", "items": { "$ref": "#/$defs/factionType" } }
  },
  "$defs": {
    "factionType": {
            "allOf": [
              { "$ref": "#/$defs/type" },
              { "properties": { "category": { "enum": ["unit", "building"] } } },
              {
                "if": { "type": "object", "required": ["category"], "properties": { "category": { "const": "unit" } } },
                "then": { "type": "object", "required": ["turnRateDeg"] }
              },
              {
                "if": { "type": "object", "required": ["category"], "properties": { "category": { "enum": ["building", "depot"] } } },
                "then": { "type": "object", "properties": { "turnRateDeg": false, "locomotor": false } }
              }
            ]
          },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "aimDeg": { "type": "integer", "minimum": 1, "maximum": 45 },
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "damageType", "damage", "rangeCenti", "cooldownTicks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "damageType": { "$ref": "#/$defs/key" },
        "damage": { "$ref": "#/$defs/positive" },
        "rangeCenti": { "$ref": "#/$defs/positive" },
        "cooldownTicks": { "$ref": "#/$defs/positive" },
        "minRangeCenti": { "$ref": "#/$defs/count" },
        "splashCenti": { "$ref": "#/$defs/count" },
        "projectileTicks": { "$ref": "#/$defs/count" },
        "speedCenti": { "$ref": "#/$defs/count" },
        "delivery": { "enum": ["homing", "ballistic"] },
        "scatterCenti": { "$ref": "#/$defs/count" },
        "aimToleranceDeg": { "$ref": "#/$defs/aimDeg" },
        "salvo": { "$ref": "#/$defs/positive" },
        "salvoIntervalTicks": { "$ref": "#/$defs/count" },
        "antiAir": { "description": "Spec 43 §4.1: which airborne units the weapon reaches.", "enum": ["none", "low", "all"] },
        "antiGround": { "description": "Spec 43 §4.1: default true.", "type": "boolean" },
        "launches": { "description": "Spec 43 §4.4: firing spawns this unit type instead of a projectile.", "$ref": "#/$defs/id" },
        "render": { "$ref": "#/$defs/weaponRender" }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["speedCenti"],
            "properties": { "speedCenti": { "type": "integer", "minimum": 1 } }
          },
          "then": { "type": "object", "properties": { "projectileTicks": { "type": "integer", "maximum": 0 } } }
        },
        {
          "if": {
            "type": "object",
            "required": ["delivery"],
            "properties": { "delivery": { "const": "homing" } }
          },
          "then": { "type": "object", "properties": { "scatterCenti": { "type": "integer", "maximum": 0 } } }
        }
      ]
    },
    "weaponRender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["tracer", "tracerHeavy", "shell", "rpg", "atgm", "rocket", "glideBomb"] },
        "flight": { "enum": ["straight", "boost", "loft", "ballistic", "topAttack"] },
        "apexCenti": { "$ref": "#/$defs/count" },
        "launch": { "enum": ["muzzle", "cannon", "backblast", "softLaunch", "rocketLaunch"] },
        "trail": { "enum": ["none", "smoke"] }
      }
    },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "armor", "render"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "enum": ["unit", "building", "depot"] },
        "armor": { "$ref": "#/$defs/key" },
        "hp": { "$ref": "#/$defs/positive" },
        "sightCenti": { "$ref": "#/$defs/count" },
        "speedCenti": { "$ref": "#/$defs/positive" },
        "turnRateDeg": { "$ref": "#/$defs/positive" },
        "turretTurnRateDeg": { "$ref": "#/$defs/positive" },
        "articulation": { "enum": ["launcher", "blade"] },
        "stowTicks": { "$ref": "#/$defs/count" },
        "locomotor": { "$ref": "#/$defs/key" },
        "cost": { "$ref": "#/$defs/count" },
        "buildTicks": { "$ref": "#/$defs/count" },
        "weapon": { "$ref": "#/$defs/id" },
        "trenchWeapon": { "description": "Spec 35 §5c: weapon fired in a trench fight instead of an antiTank main weapon.", "$ref": "#/$defs/id" },
        "requires": { "$ref": "#/$defs/ids" },
        "builds": { "$ref": "#/$defs/ids" },
        "produces": { "$ref": "#/$defs/ids" },
        "capacity": { "$ref": "#/$defs/count" },
        "loadTicks": { "$ref": "#/$defs/count" },
        "unloadTicks": { "$ref": "#/$defs/count" },
        "footprint": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 1, "maximum": 8 }
        },
        "radiusCenti": { "$ref": "#/$defs/positive" },
        "power": { "type": "integer" },
        "requiresPower": { "type": "boolean" },
        "dropOff": { "type": "boolean" },
        "freeUnit": { "$ref": "#/$defs/id" },
        "repairsVehicles": { "description": "Spec 39: this building is a vehicle repair pad.", "type": "boolean" },
        "amphibious": { "description": "Spec 36: the vehicle drives over deep water too (Zero Hour Surfaces = GROUND WATER).", "type": "boolean" },
        "infinite": { "description": "Spec 36: a depot that never runs out (a port).", "type": "boolean" },
        "healsInfantry": { "description": "Spec 40: damaged infantry heal inside this building (Zero Hour HealContain).", "type": "boolean" },
        "oneWay": {
          "description": "Spec 43 §4.2: the unit is its own warhead.",
          "type": "object",
          "additionalProperties": false,
          "required": ["warhead"],
          "properties": {
            "warhead": { "$ref": "#/$defs/id" },
            "fuelTicks": { "$ref": "#/$defs/positive" },
            "armTiles": { "$ref": "#/$defs/positive" }
          }
        },
        "sortie": {
          "description": "Spec 43 §4.3: a flyer with a clip that reloads at a base.",
          "type": "object",
          "additionalProperties": false,
          "required": ["clip", "reloadTicks"],
          "properties": { "clip": { "$ref": "#/$defs/positive" }, "reloadTicks": { "$ref": "#/$defs/positive" } }
        },
        "link": { "description": "Spec 43 §4.5: how the unit is steered; absent is unjammable.", "enum": ["radio", "fibre", "gnss", "autonomous"] },
        "jammer": {
          "description": "Spec 43 §4.5: jams hostile radio and gnss links inside the radius.",
          "type": "object",
          "additionalProperties": false,
          "required": ["radiusCenti"],
          "properties": { "radiusCenti": { "$ref": "#/$defs/positive" } }
        },
        "gnssScatterCenti": { "description": "Spec 43 §4.5: how far off a jammed gnss warhead lands.", "$ref": "#/$defs/positive" },
        "charges": {
          "description": "Spec 43 §4.4: a launcher's drones are its ammunition. Up to max launches, one charge back every refillTicks next to an own resupplies unit or building within refillRadiusCenti; without a radius it refills by itself.",
          "type": "object",
          "additionalProperties": false,
          "required": ["max", "refillTicks"],
          "properties": {
            "max": { "$ref": "#/$defs/positive" },
            "refillTicks": { "$ref": "#/$defs/positive" },
            "refillRadiusCenti": { "$ref": "#/$defs/positive" }
          }
        },
        "resupplies": { "description": "Spec 43 §4.4: launcher units of the same side refill their charges next to this one.", "type": "boolean" },
        "hover": { "description": "Spec 43 §4.1: a rotorcraft. Only these flyers may hover; every other flyer is fixed-wing and never stops while airborne.", "type": "boolean" },
        "lowObservable": { "description": "Spec 43 §4.1: enemy weapons engage it only inside a third of their range.", "type": "boolean" },
        "transport": {
          "description": "Spec 34: infantry can ride this vehicle (Zero Hour TransportContain).",
          "type": "object",
          "additionalProperties": false,
          "required": ["slots", "damagePct", "exitTicks"],
          "properties": {
            "slots": { "type": "integer", "minimum": 1, "maximum": 12 },
            "fireFromInside": { "type": "boolean" },
            "damagePct": { "type": "integer", "minimum": 0, "maximum": 100 },
            "exitTicks": { "type": "integer", "minimum": 0 }
          }
        },
        "render": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/positive" }
            },
            "height": { "$ref": "#/$defs/positive" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "unit" } } },
          "then": {
            "required": ["hp", "sightCenti", "speedCenti"],
            "properties": {
              "footprint": false, "produces": false, "power": false, "requiresPower": false,
              "dropOff": false, "freeUnit": false,
              "render": { "required": ["size"], "properties": { "height": false } }
            }
          }
        },
        {
          "if": { "properties": { "category": { "const": "building" } } },
          "then": {
            "required": ["hp", "sightCenti", "footprint"],
            "properties": {
              "speedCenti": false, "builds": false, "capacity": false, "loadTicks": false, "unloadTicks": false,
              "render": { "required": ["height"], "properties": { "size": false } }
            }
          }
        },
        {
          "if": { "properties": { "category": { "const": "depot" } } },
          "then": {
            "required": ["footprint"],
            "properties": {
              "hp": false, "sightCenti": false, "speedCenti": false, "cost": false, "buildTicks": false,
              "weapon": false, "requires": false, "builds": false, "produces": false, "capacity": false,
              "unloadTicks": false, "power": false, "requiresPower": false,
              "dropOff": false, "freeUnit": false,
              "render": { "required": ["height"], "properties": { "size": false } }
            }
          }
        }
      ]
    }
  }
}
