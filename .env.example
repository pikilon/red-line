# Overnight runner (scripts/night-runner.sh). Copy to .env.local to override.

# Agent harness: dsh (DeepSeek Harness headless) or opencode.
RUNNER_ENGINE=dsh
# Provider route and model. Any provider other than lmstudio is a paid API
# (D-11): the runner asks on the terminal and falls back to the local model
# when there is no TTY, no answer before the timeout, or the answer is not yes.
RUNNER_PROVIDER=lmstudio
RUNNER_MODEL=ornith-1.5-35b-a3b-mlx
RUNNER_LOCAL_MODEL=ornith-1.5-35b-a3b-mlx
RUNNER_LMSTUDIO_URL=http://127.0.0.1:1234/v1
RUNNER_CONFIRM_TIMEOUT_SECONDS=60
# Owner confirmation of a paid route for one unattended run, e.g.
# RUNNER_PAID_CONFIRMED=deepseek-official/deepseek-flash. Must equal
# RUNNER_PROVIDER/RUNNER_MODEL exactly. Pass it on the command line for that
# run; never put it in .env.local.
RUNNER_PAID_CONFIRMED=
# DeepSeek Harness profile booted with scripts/night-runner.dsh.yml on top.
RUNNER_DSH_PROFILE=headless

# Queue: open issues with this label, unassigned, whose blockers are closed,
# lowest number first. RUNNER_ISSUE=<n> works on that one issue only.
RUNNER_LABEL=ready-local
RUNNER_ISSUE=
# Attempts per issue (counted across runs) before relabelling it needs-pro.
RUNNER_MAX_ATTEMPTS=3
# Local time (HH:MM) at which the runner stops; agent runs are cut at it.
RUNNER_STOP_AT=07:00
RUNNER_AGENT_TIMEOUT_MINUTES=90
# 1 = squash-merge each PR as soon as its CI is green, so issues blocked by it
# are picked up in the same run. Unset or 0 = leave PRs open for review.
RUNNER_AUTO_MERGE=
